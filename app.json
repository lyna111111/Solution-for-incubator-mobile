{
  "expo": {
    "name": "Solution Incubateur",
    "slug": "solution-incubator-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solutionincubator.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e0e2c",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.solutionincubator.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0e0e2c"
        }
      ],
      "expo-sharing"
    ],
    "scheme": "incubateur"
  }
}
